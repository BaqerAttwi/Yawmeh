PORT=3001
HOST=127.0.0.1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=daywell
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=daywell
# Only required when using the optional Docker Compose database.
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-password
# Used only by db:init to create the first administrator. No public registration.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-8-to-24-characters
# Set true when serving through HTTPS. Keep false for local HTTP development.
COOKIE_SECURE=false
# Set NODE_ENV=production, COOKIE_SECURE=true and your public HTTPS origin on deployment.
# Leave APP_ORIGIN blank for local development (including the Vite proxy).
APP_ORIGIN=
# Same-server Caddy/nginx: loopback. Leave blank without a reverse proxy.
# Never use true, a hop count, or a public wildcard; list only your proxy IP/CIDR.
TRUST_PROXY=
TIMEZONE=Asia/Beirut
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Character request understanding (text only). Key is never sent to browsers.
COMPANION_AI_ENABLED=false
# At most 10 paid attempts per account per calendar day; local chat continues.
COMPANION_AI_DAILY_LIMIT=10
COMPANION_AI_MONTHLY_LIMIT=1000

# Optional natural companion voice. Requires a funded OpenAI API key above.
# Disabled by default; users must also select Natural voice in chat settings.
COMPANION_VOICE_ENABLED=false

# Google OAuth web client (separate from the Gemini key).
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
