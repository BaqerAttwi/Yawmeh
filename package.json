{
  "name": "daywell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/src/index.js\" \"vite --host 127.0.0.1 --configLoader runner\"",
    "build": "vite build --configLoader runner",
    "start": "node server/src/index.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "db:init": "node server/scripts/migrate.js",
    "check:setup": "node server/scripts/check-setup.js",
    "check:production": "node server/scripts/check-production.js",
    "db:backup": "node server/scripts/backup.js"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.14.0",
    "nodemailer": "^10.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "vite": "^6.4.5"
  }
}
