NODE_ENV=production
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=https://your-domain.example
COOKIE_SECURE=true
TRUST_PROXY=loopback
TIMEZONE=Asia/Beirut
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=daywell
MYSQL_USER=daywell
MYSQL_PASSWORD=replace-with-a-unique-database-password
# Only needed for the first migration; remove these admin variables afterward.
ADMIN_NAME=Administrator
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-unique-admin-password-8-to-24-characters
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional paid natural voice. Leave disabled without a funded API account.
COMPANION_VOICE_ENABLED=false
OPENAI_API_KEY=
# Optional Gemini request understanding; users also opt in in companion settings.
GEMINI_API_KEY=
COMPANION_AI_ENABLED=false
COMPANION_AI_DAILY_LIMIT=10
COMPANION_AI_MONTHLY_LIMIT=1000
